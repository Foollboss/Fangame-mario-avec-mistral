{
  "name": "supersonic-arena",
  "version": "1.0.0",
  "description": "Jeu de foot en voitures a reaction inspire de Rocket League, jouable sur PC dans le navigateur.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=dist/game.js",
    "watch": "esbuild src/main.js --bundle --sourcemap --format=iife --target=es2020 --outfile=dist/game.js --watch",
    "serve": "npx http-server . -p 8080 -c-1",
    "test": "node tests/sim.test.js"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
