{
  "name": "voxerra",
  "version": "1.0.0",
  "private": true,
  "description": "Voxerra — sandbox voxel original (exploration, survie, construction, dimensions).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "server": "tsx server/server.ts",
    "screenshot": "node scripts/screenshot.mjs",
    "build:html": "tsc --noEmit -p tsconfig.json && node scripts/build-html.mjs",
    "icons": "node scripts/build-icons.mjs",
    "build:exe": "npm --prefix desktop install && npm --prefix desktop run build:win",
    "build:launcher": "node launcher/build.mjs",
    "build:apk": "node scripts/build-html.mjs && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "three": "^0.186.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.11"
  }
}
