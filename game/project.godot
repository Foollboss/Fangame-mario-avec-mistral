; Asphalt Legends Unite — Fangame (non officiel)
; Projet Godot 4.7 — rendu Compatibility (OpenGL ES 3) pour une compatibilité Android maximale.

config_version=5

[application]

config/name="Asphalt Unite Fangame"
config/description="Fangame non officiel inspiré d'Asphalt Legends Unite."
config/version="1.0.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.02, 0.16, 1)
boot_splash/image="res://assets/ui/splash.png"
boot_splash/fullsize=true
config/icon="res://assets/ui/icon.png"

[autoload]

Game="*res://scripts/autoload/game.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/default_font_multichannel_signed_distance_field=false

[input_devices]

pointing/emulate_touch_from_mouse=true
sensors/enable_accelerometer=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.07, 0.02, 0.16, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
textures/canvas_textures/default_texture_filter=1
